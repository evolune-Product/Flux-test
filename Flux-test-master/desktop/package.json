{
  "name": "flasqo-desktop",
  "productName": "Flasqo",
  "version": "1.0.0",
  "description": "Flasqo — API testing platform. Manual request builder + AI-powered automated test suites.",
  "main": "main.js",
  "author": "Flasqo",
  "license": "MIT",
  "scripts": {
    "start": "FLASQO_DEV=1 electron .",
    "start:win": "set FLASQO_DEV=1&& electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.flasqo.desktop",
    "productName": "Flasqo",
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/flasqo-backend",
        "to": "backend"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Development",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
